# ── CLUBEVERSO — env.example ───────────────────────────────────────────────
# Copie para .env e preencha. Nunca commitar .env com secrets reais.

# Database — PostgreSQL 16 (Docker ou Neon/Supabase)
# Local Docker:  postgresql://clubverso:clubverso@localhost:5432/clubverso?schema=public
# Neon:          postgresql://user:pass@ep-xxx.neon.tech/clubverso?sslmode=require
DATABASE_URL="postgresql://clubverso:clubverso@localhost:5432/clubverso?schema=public"

# Auth — NextAuth.js v5
AUTH_SECRET="gere-com-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Storage — S3 compatível (AWS S3 ou Cloudflare R2)
STORAGE_PROVIDER="R2" # S3 | R2 | MOCK
STORAGE_ENDPOINT="https://xxx.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="clubverso"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL="https://cdn.clubverso.com"

# Payments — PIX Gateway (abstração)
PAYMENT_PROVIDER="MOCK" # MOCK | EFI | MERCADOPAGO
PIX_WEBHOOK_SECRET="pix-webhook-secret-dev"
EFI_CLIENT_ID=""
EFI_CLIENT_SECRET=""
EFI_CERT_PATH=""
MERCADOPAGO_ACCESS_TOKEN=""

# Email — Resend
RESEND_API_KEY="re_xxx"
EMAIL_FROM="CLUBEVERSO <contato@clubverso.com>"

# NFT — Feature flag
NFT_ENABLED="false"
NFT_CHAIN="polygon"
NFT_CONTRACT_ADDRESS=""
NFT_PRIVATE_KEY=""
PINATA_JWT=""

# Redis (opcional — para fila/cache; fallback in-memory em dev)
REDIS_URL="redis://localhost:6379"

# Admin seed
ADMIN_EMAIL="admin@clubverso.com"
ADMIN_PASSWORD="Clubverso@2026"
